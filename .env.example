# Browser-safe Supabase configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only eCourts credential. Never prefix this with VITE_.
ECOURTS_API_KEY=

# Server-only scheduled sync credentials.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# Optional: active cases refreshed per daily run (1-20, default 10).
ECOURTS_CRON_BATCH_SIZE=10

# Optional dedicated AES-256 encryption material for dashboard-managed secrets.
# When omitted, the server-only Supabase service-role key is used as key material.
INTEGRATION_SETTINGS_ENCRYPTION_KEY=
